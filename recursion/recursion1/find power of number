class Solution {
public:
    double myPow(double x, int n) {
        if(n==0)return 1;
        if(n<0)return 1/myPow(x,-n);
        return x*myPow(x,n-1);
    }
}; 

class Solution {
public:
    double myPow(double x, int n) {
        long long m = n; 
        double ans = 1.0;

        if (m < 0) {
            x = 1 / x;
            m = -m;
        }

        while (m > 0) {
            if (m % 2 == 1) {
                ans *= x;
            }
            x *= x;
            m /= 2;
        }

        // Handle underflow explicitly
        if (fabs(ans) < 1e-308) return 0.0;

        return ans;
    }
};
